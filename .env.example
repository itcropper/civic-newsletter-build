# ============================================================
# Copy this to .env and fill in your values
# ============================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase ops_user (restricted DML-only)
SUPABASE_OPS_DB_URL=postgresql://ops_user:password@db.your-project.supabase.co:5432/postgres

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# AssemblyAI (video transcription with speaker diarization)
ASSEMBLYAI_API_KEY=your-assemblyai-key

# Redis (Upstash or other)
REDIS_URL=redis://default:password@your-redis.upstash.io:6379

# Beehiiv
BEEHIIV_API_KEY=your-beehiiv-api-key
BEEHIIV_PUBLICATION_ID=your-publication-id

# Facebook Marketing API (not yet configured)
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_AD_ACCOUNT_ID=
