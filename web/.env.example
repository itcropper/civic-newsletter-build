# Supabase project credentials (anon key is the legacy JWT format)
NEXT_PUBLIC_SUPABASE_URL=https://yfynwejgbyeisharldyk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Public site URL used for RSS, OG tags, canonical links.
NEXT_PUBLIC_SITE_URL=https://birmingham-civic.vercel.app

# === City resolution ===
# Two modes, in order of preference:
#
# MODE A (multi-tenant, production): one deployment serves all cities.
# Set UMBRELLA_DOMAIN to your apex domain. The Host header drives the
# city lookup (e.g. birmingham.civicwire.com -> cities.subdomain='birmingham').
# Requires wildcard DNS + Vercel Pro for wildcard custom domains.
UMBRELLA_DOMAIN=

# MODE B (single-tenant, MVP / free-tier Vercel): one Vercel project per
# city, each fixed to one subdomain via this fallback. Used when the Host
# header doesn't reveal a real city subdomain (e.g. *.vercel.app).
CITY_SUBDOMAIN=birmingham
