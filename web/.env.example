# Supabase project credentials (anon key is the legacy JWT format).
# The anon key is designed to be public — it identifies the project, and
# Row Level Security policies on the database are what actually gate access.
NEXT_PUBLIC_SUPABASE_URL=https://yfynwejgbyeisharldyk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# === Routing ===
# Routing is path-based. The splash lives at `/`; every city lives at
# `/{cities.subdomain}` on the same host. No subdomain DNS required.
#
# No env var is needed for normal operation — the city slug comes from the URL.

# === Legacy redirect (optional, transitional) ===
# If you have an old single-tenant Vercel project that used to set
# CITY_SUBDOMAIN, you can leave it set during the cutover. When set,
# middleware.ts will 308-redirect `/` -> `/{CITY_SUBDOMAIN}` so old links
# keep working. Delete the env var (and middleware.ts) once the cutover
# is complete.
# CITY_SUBDOMAIN=birmingham-al
